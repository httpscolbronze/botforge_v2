{
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://botforge-v2-1.onrender.com/$1",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS",
        "Access-Control-Allow-Headers": "Authorization, Content-Type, X-Client-Id"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}